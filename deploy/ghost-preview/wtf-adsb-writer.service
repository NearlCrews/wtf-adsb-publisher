# Template user unit for ~/.config/systemd/user. The paths assume the checkout
# at ~/src/wtf-adsb-publisher and the configuration under /srv/wtf-adsb-publisher,
# as in the README; change them if yours are elsewhere.
[Unit]
Description=Upgrade WTF ADS-B story prose within the shared AI budget
After=network-online.target
ConditionPathExists=!/srv/wtf-adsb-publisher/control/activation.hold

[Service]
Type=oneshot
WorkingDirectory=%h/src/wtf-adsb-publisher
ExecStart=/usr/bin/python3 %h/src/wtf-adsb-publisher/tools/run_container_job.py --config /srv/wtf-adsb-publisher/config/jobs.json run write
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Compose supplies the same AI environment and spending store to both writers.
UMask=0077
TimeoutStartSec=infinity
Nice=10
