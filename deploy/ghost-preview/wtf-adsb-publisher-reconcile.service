# Template user unit for ~/.config/systemd/user. The paths assume the checkout
# at ~/src/wtf-adsb-publisher and the configuration under /srv/wtf-adsb-publisher,
# as in the README; change them if yours are elsewhere.
[Unit]
Description=Reconcile existing WTF ADS-B publisher containers after startup
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/wtf-adsb-publisher
ExecStart=/usr/bin/python3 %h/src/wtf-adsb-publisher/tools/run_container_job.py --config /srv/wtf-adsb-publisher/config/jobs.json reconcile
Environment=PATH=/usr/local/bin:/usr/bin:/bin
UMask=0077
TimeoutStartSec=infinity
Nice=10

[Install]
WantedBy=default.target
