# AI settings for the story writer and weekly researcher. Copy to config/ai.env
# (mode 0600). Keep the budget values equal across publisher writers: they share
# the publisher budget store's ai_runs ledger, and each process enforces its own
# settings.
#
# false pauses this host's writers. tools/run_public_writer.py --pause-ai turns
# on the budget store's kill switch, which pauses every writer using that store.
AI_ENABLED=true
# One cap for every AI request in a UTC day.
AI_DAILY_BUDGET_USD=1.00
# Held for public story prose and research: other requests stop at the cap less
# this ($0.25). Writers refuse to start when it is below the largest public
# request reservation ($0.595 with gpt-6.1-sol).
AI_PUBLIC_RESERVE_USD=0.75
AI_PUBLIC_MODEL=gpt-6.1-sol
AI_PUBLIC_REASONING_EFFORT=low
