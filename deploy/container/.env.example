# Copy privately; all paths must be absolute and exist before a job starts.
# docker image inspect --format '{{.Id}}' wtf-adsb-publisher:local
PUBLISHER_IMAGE=sha256:REPLACE_WITH_TESTED_LOCAL_IMAGE_ID
PUBLISHER_STATE_DIR=/srv/wtf-adsb-publisher/state
PUBLISHER_ARTIFACTS_DIR=/srv/wtf-adsb-publisher/artifacts
PUBLISHER_CONFIG_DIR=/srv/wtf-adsb-publisher/config
PUBLISHER_CONTROL_DIR=/srv/wtf-adsb-publisher/control
ENGINE_FEED_DIR=/srv/wtf-adsb/feed
# Optional: the operator-supplied reference files, mounted read-only at /references,
# such as /srv/wtf-adsb/references. Create the directory first: Compose turns a
# missing path into an empty root-owned directory. Empty keeps the built-in rules.
PUBLISHER_REFERENCE_DIR=
PUBLISHER_AI_ENV_FILE=/srv/wtf-adsb-publisher/config/ai.env
PUBLISHER_GHOST_KEY_FILE=/srv/wtf-adsb-publisher/secrets/ghost-admin-key
PUBLISHER_OPENAI_KEY_FILE=/srv/wtf-adsb-publisher/secrets/openai-api-key
PUBLISHER_SSH_CONFIG=/srv/wtf-adsb-publisher/ssh/config
PUBLISHER_SSH_KEY_FILE=/srv/wtf-adsb-publisher/ssh/id_ed25519
PUBLISHER_SSH_KNOWN_HOSTS=/srv/wtf-adsb-publisher/ssh/known_hosts
# Optional: the private terms file, mounted read-only at /config/private-terms.txt.
# Set publisher.json's private_terms_file to that path. Empty mounts /dev/null.
PUBLISHER_PRIVATE_TERMS_FILE=
# Optional: the About page's text, mounted read-only at /config/about.md, where
# publisher.json's about_file points. Empty mounts /dev/null, which counts as unset.
PUBLISHER_ABOUT_FILE=
# Optional: --no-deploy publishes to Ghost and sends no static release.
PUBLISHER_PUBLISH_OPTIONS=
# Optional: the jobs' account (the image's is 1000:1000) and memory limit.
PUBLISHER_UID=1000
PUBLISHER_GID=1000
PUBLISHER_MEMORY_LIMIT=4g
