{{!-- Served as JSON at /search-index/ (see routes.yaml) for the header search.
      Text is URL-encoded so no title or excerpt can break the JSON. --}}
[{{#get "posts" limit="100" include="tags" order="published_at desc"}}{{#foreach posts}}{"title":"{{encode title}}","url":"{{url}}","excerpt":"{{#if custom_excerpt}}{{encode custom_excerpt}}{{else if excerpt}}{{encode excerpt}}{{/if}}","topic":"{{#if primary_tag}}{{encode primary_tag.name}}{{/if}}"}{{#unless @last}},{{/unless}}{{/foreach}}{{/get}}]
