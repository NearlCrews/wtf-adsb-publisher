{{!< default}}
{{#post}}
  <article class="article {{post_class}}">
    <header class="article-heading column">
      {{> "breadcrumbs"}}
      {{#if eyebrow}}<p class="story-eyebrow">{{#foreach eyebrow}}<a href="{{url}}">{{label}}</a>{{/foreach}}{{> "source-badge"}}</p>{{else}}{{> "story-meta"}}{{/if}}
      <h1>{{title}}</h1>
      {{#if custom_excerpt}}<p
          class="article-deck"
        >{{custom_excerpt}}</p>{{/if}}
      {{#if byline}}
        <p class="article-byline">{{authors}}{{#foreach byline}}<span aria-hidden="true">/</span><span>{{label}} <time datetime="{{datetime}}">{{text}}</time></span>{{/foreach}}{{#if unpublished}}<span aria-hidden="true">/</span><span>Unpublished review</span>{{/if}}</p>
      {{else}}
        <div class="article-byline">{{authors}}<span
            aria-hidden="true"
          >/</span>{{#if published_at}}<time datetime="{{date format="YYYY-MM-DD"}}">Observed {{date
              format="D MMM YYYY"
            }}</time>{{else}}<span>Unpublished review</span>{{/if}}</div>
      {{/if}}
    </header>
    {{#if feature_media}}
      {{> "event-visual" feature_media article=true lead=true}}
    {{else}}{{#if feature_image}}
      <figure class="article-cover column"><img
          src="{{img_url feature_image size="xl"}}"
        srcset="{{> "srcset"}}"
        sizes="(max-width: 760px) calc(100vw - 40px), 680px"
          alt="{{feature_image_alt}}"
          width="1800"
          height="1000"
          fetchpriority="high"
        />{{#if feature_image_caption}}<figcaption
          >{{{feature_image_caption}}}</figcaption>{{/if}}</figure>
    {{/if}}{{/if}}
    {{#if profile_image}}{{> "event-visual" profile_image article=true}}{{/if}}
    {{#if airframe_photo}}{{> "airframe-photo" airframe_photo}}{{/if}}
    {{#if type_background_first}}{{#if type_background}}{{> "type-background" type_background}}{{/if}}{{/if}}
    <div class="gh-content prose">{{content}}</div>
    {{#unless type_background_first}}{{#if type_background}}{{> "type-background" type_background}}{{/if}}{{/unless}}
    {{#if aircraft_related}}{{> "aircraft-related" aircraft_related}}{{/if}}
    {{#if related}}{{> "related-stories" related}}{{/if}}
    <footer class="article-end column"><span class="eyebrow">Explore the journal.</span><a
        class="text-link"
        href="{{@site.url}}/stories/"
      >All stories <span aria-hidden="true">↗</span></a></footer>
  </article>
{{/post}}
