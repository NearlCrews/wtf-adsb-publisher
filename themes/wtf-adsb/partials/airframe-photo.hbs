<figure class="airframe-photo column" data-media-kind="airframe-photo">
  <a href="{{link}}"><img src="{{src}}" alt="{{alt}}" width="{{width}}" height="{{height}}" loading="lazy" decoding="async" /></a>
  <figcaption>{{subject}}, photographed on another occasion, not during this flight. Photo: {{photographer}} / <a href="{{link}}">Planespotters.net</a></figcaption>
</figure>
