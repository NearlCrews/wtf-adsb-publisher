<table class="event-fact-table event-measurement-table">
  <caption>{{scope}}{{#if interval}}<span class="event-measurement-interval">{{interval}}</span>{{/if}}</caption>
  <tbody>{{#foreach rows}}<tr><th scope="row">{{label}}</th><td>{{value}}{{#if unit}} <small>{{unit}}</small>{{/if}}</td></tr>{{/foreach}}</tbody>
</table>
