<div class="topic-sections">{{#foreach sections}}<section class="topic-section" aria-labelledby="section-{{slug}}">{{#if index}}<h2 id="section-{{slug}}">{{title}}</h2>{{else}}<h3 id="section-{{slug}}">{{title}}</h3>{{/if}}<ul>{{#foreach topics}}<li><a href="{{url}}">{{title}}</a> <span class="topic-count">{{countLabel}}</span>{{#if description}}<p>{{description}}</p>{{/if}}</li>{{/foreach}}</ul></section>{{/foreach}}</div>
