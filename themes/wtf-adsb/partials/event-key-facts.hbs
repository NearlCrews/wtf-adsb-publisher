<div class="event-key-group">
  {{#if scope}}<p class="event-key-scope">{{scope}}{{#if interval}}<span>{{interval}}</span>{{/if}}</p>{{/if}}
  <dl class="event-key-facts">{{#foreach rows}}<div><dt>{{label}}</dt><dd>{{value}}{{#if unit}} <small>{{unit}}</small>{{/if}}</dd>{{#if meaning}}<dd class="event-key-meaning">{{meaning}}</dd>{{/if}}</div>{{/foreach}}</dl>
</div>
